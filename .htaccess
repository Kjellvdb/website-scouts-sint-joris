# ========================================
# Scouts Sint-Joris Aalst - .htaccess
# ========================================

RewriteEngine On

# ------------------------------------------------
# Allow access to sendmail.php (Apache 2.4)
# ------------------------------------------------
<Files "sendmail.php">
  Require all granted
</Files>

# ------------------------------------------------
# Force HTTPS + non-www (canonical)
# ------------------------------------------------
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.scoutssintjoris\.be$ [NC]
RewriteRule ^(.*)$ https://scoutssintjoris.be/$1 [R=301,L]

# ------------------------------------------------
# Redirect /index.html to /
# ------------------------------------------------
RewriteRule ^index\.html$ / [R=301,L]

# ------------------------------------------------
# Canonical: force .html in URLs
# ------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [R=301,L]

# ------------------------------------------------
# Internally serve .html without showing it
# ------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ------------------------------------------------
# Compressie (Gzip) voor Snellere Laadtijden
# ------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ------------------------------------------------
# Browser Caching
# ------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# ========================================
# End
# ========================================
